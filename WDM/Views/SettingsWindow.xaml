<Window x:Class="WDM.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置中心"
        Width="410"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border CornerRadius="18"
            Background="{DynamicResource PanelDarkBrush}"
            BorderBrush="{DynamicResource PanelStrokeBrush}"
            BorderThickness="1"
            Effect="{DynamicResource PanelShadow}">
        <Grid Margin="22,14,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏（可拖动） ===== -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Ellipse Width="8" Height="8"
                             Fill="{DynamicResource AccentBrush}"
                             Effect="{DynamicResource AccentGlow}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock Text="设置中心"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        Style="{StaticResource GhostIconButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTip="关闭"/>
            </Grid>

            <!-- ===== 透明度表盘 ===== -->
            <Canvas x:Name="GaugeCanvas"
                    Grid.Row="1"
                    Width="300" Height="168"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonDown="Gauge_MouseLeftButtonDown"
                    MouseMove="Gauge_MouseMove"
                    MouseLeftButtonUp="Gauge_MouseLeftButtonUp"
                    MouseLeave="Gauge_MouseLeave">
                <TextBlock Text="{Binding GaugeMinLabel}"
                           Canvas.Left="12" Canvas.Top="136"
                           Style="{StaticResource DarkCaptionTextStyle}"/>
                <TextBlock Text="{Binding GaugeMaxLabel}"
                           Canvas.Right="12" Canvas.Top="136"
                           Style="{StaticResource DarkCaptionTextStyle}"/>
            </Canvas>

            <!-- ===== 表盘读数 ===== -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,-4,0,2">
                <TextBlock Text="{Binding GaugeText}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding GaugeCaption}"
                           Style="{StaticResource DarkCaptionTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Row="3" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12"/>

            <!-- ===== 桌面组件 ===== -->
            <TextBlock Grid.Row="4"
                       Text="桌面组件"
                       Style="{StaticResource DarkCaptionTextStyle}"
                       Margin="10,0,0,4"/>

            <!-- 便签：点击本行切换表盘为便签透明度，再次点击返回 Dock -->
            <Border Grid.Row="5" Style="{StaticResource SettingsRowStyle}" Cursor="Hand"
                    Tag="Note" MouseLeftButtonDown="PanelRow_MouseLeftButtonDown"
                    ToolTip="点击调节便签透明度">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 统一图标：圆角底 + Segoe MDL2 字形 -->
                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="便签" Style="{StaticResource DarkTitleTextStyle}"/>
                        <TextBlock Text="新增便签；点击本行可调节透明度"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource AccentCircleButtonStyle}"
                            Command="{Binding AddNoteCommand}"
                            VerticalAlignment="Center"
                            ToolTip="新增一张便签"/>
                </Grid>
            </Border>

            <!-- 待办事项：点击本行切换表盘为待办透明度，再次点击返回 Dock -->
            <Border Grid.Row="6" Style="{StaticResource SettingsRowStyle}" Cursor="Hand"
                    Tag="Todo" MouseLeftButtonDown="PanelRow_MouseLeftButtonDown"
                    ToolTip="点击调节待办透明度">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="待办事项" Style="{StaticResource DarkTitleTextStyle}"/>
                        <TextBlock Text="新增待办；点击本行可调节透明度"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource AccentCircleButtonStyle}"
                            Command="{Binding AddTodoCommand}"
                            VerticalAlignment="Center"
                            ToolTip="新增一个待办面板"/>
                </Grid>
            </Border>

            <!-- 开机自启动 -->
            <Border Grid.Row="7" Style="{StaticResource SettingsRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="开机自启动" Style="{StaticResource DarkTitleTextStyle}"/>
                        <TextBlock Text="登录 Windows 后自动在后台运行 WDM"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding AutoStart}"
                              VerticalAlignment="Center"
                              ToolTip="开机自启动"/>
                </Grid>
            </Border>

            <!-- 暗夜模式：便签 / 待办切换为黑色透明毛玻璃 -->
            <Border Grid.Row="8" Style="{StaticResource SettingsRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                        <TextBlock Text="&#xE708;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="暗夜模式" Style="{StaticResource DarkTitleTextStyle}"/>
                        <TextBlock Text="便签与待办切换为黑色毛玻璃"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding NightMode}"
                              VerticalAlignment="Center"
                              ToolTip="暗夜模式"/>
                </Grid>
            </Border>

            <!-- 霓虹模式：点击本行切换表盘为全局色调，再次点击返回 Dock -->
            <Border Grid.Row="9" Style="{StaticResource SettingsRowStyle}" Cursor="Hand"
                    Tag="Icon" MouseLeftButtonDown="PanelRow_MouseLeftButtonDown"
                    ToolTip="点击调节全局色调">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                        <TextBlock Text="&#xE790;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="霓虹模式" Style="{StaticResource DarkTitleTextStyle}"/>
                        <TextBlock Text="点击本行可设置悬浮倒影图标具体参数"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding TechIconMode}"
                              VerticalAlignment="Center"
                              ToolTip="默认模式 / 科技模式"/>
                </Grid>
            </Border>

            <!-- ===== 霓虹模式下一级：显示应用名称 + 颜色跟随（默认隐藏，点击霓虹模式行展开） ===== -->
            <StackPanel Grid.Row="10" Margin="22,4,0,0"
                        Visibility="{Binding ShowIconLabels, Converter={StaticResource BooleanToVisibility}}">

                <!-- 行 1：显示应用名称 -->
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="显示应用名称"
                                   Style="{StaticResource DarkTitleTextStyle}"
                                   VerticalAlignment="Center"
                                   ToolTip="在 Dock 图标下方显示多行发光文字"/>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding ShowAppLabels}"
                                  VerticalAlignment="Center"
                                  ToolTip="显示应用名称"/>
                    </Grid>
                </Border>

                <!-- 行 2：名称颜色跟随全局色调 -->
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="名称颜色跟随全局色调"
                                   Style="{StaticResource DarkTitleTextStyle}"
                                   VerticalAlignment="Center"
                                   ToolTip="选中则名称颜色与全局色调一致，否则默认白色"/>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding AppLabelColorFollowTone}"
                                  VerticalAlignment="Center"
                                  ToolTip="选中则名称颜色跟随全局色调"/>
                    </Grid>
                </Border>

                <!-- 行 3：图标大小 -->
                <Border Style="{StaticResource SettingsRowStyle}" ToolTip="Dock 图标像素大小">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="图标大小"
                                   Style="{StaticResource DarkTitleTextStyle}"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1"
                                Minimum="28" Maximum="64"
                                IsMoveToPointEnabled="True"
                                Value="{Binding DockIconSize, Mode=TwoWay}"
                                Height="18" Margin="12,0,8,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DockIconSize, StringFormat={}{0}px}"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 行 4：字体大小 -->
                <Border Style="{StaticResource SettingsRowStyle}" ToolTip="应用名的字体像素大小">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="字体大小"
                                   Style="{StaticResource DarkTitleTextStyle}"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1"
                                Minimum="7" Maximum="16"
                                IsMoveToPointEnabled="True"
                                Value="{Binding AppLabelFontSize, Mode=TwoWay}"
                                Height="18" Margin="12,0,8,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding AppLabelFontSize, StringFormat={}{0}px}"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ===== 全局色调滑轨（始终显示：控制面板边框、应用名颜色、霓虹图标） ===== -->
            <StackPanel Grid.Row="11" Margin="10,4,10,0">
                <Grid Margin="0,0,2,0">
                    <TextBlock Text="全局色调" Style="{StaticResource DarkCaptionTextStyle}"/>
                    <TextBlock Text="{Binding IconTone, StringFormat={}{0:F0}°}"
                               HorizontalAlignment="Right"
                               Style="{StaticResource DarkCaptionTextStyle}"/>
                </Grid>
                <Slider Style="{StaticResource HueSliderStyle}"
                        Minimum="0" Maximum="360"
                        Value="{Binding IconTone, Mode=TwoWay}"
                        Margin="0,6,0,2"/>
            </StackPanel>

            <!-- ===== 记录面板：打开独立的记录查看窗口 ===== -->
            <Border Grid.Row="12" Style="{StaticResource SettingsRowStyle}" Cursor="Hand"
                    ToolTip="按时间查看便签与待办的历史记录"
                    MouseLeftButtonDown="RecordsRow_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="记录面板" Style="{StaticResource DarkTitleTextStyle}"/>
                        <TextBlock Text="按时间查看便签与待办的记录"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
