<Window x:Class="WDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WDM.ViewModels"
        Title="WDM - 桌面悬浮管理器"
        Height="180" Width="Auto"
        SizeToContent="Width"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        AllowDrop="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- ====== 右键 ContextMenu：图标右键菜单 ====== -->
        <ContextMenu x:Key="AppItemContextMenu">
            <MenuItem Header="移除"
                      Click="RemoveAppMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="打开文件位置"
                      Click="OpenFileLocationMenuItem_Click"/>
        </ContextMenu>

        <!-- ====== Dock 图标按钮样式 ====== -->
        <Style x:Key="DockIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenu" Value="{StaticResource AppItemContextMenu}"/>
            <!-- 鼠标悬浮音效：统一交给 SoundService 播放（预加载，无磁盘 IO） -->
            <EventSetter Event="MouseEnter" Handler="DockIcon_MouseEnter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                CornerRadius="12"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- 悬浮：只加一圈发光蓝边框，不铺白色底 -->
                                <Setter TargetName="border" Property="BorderBrush" Value="#CC2CC7F7"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#2CC7F7"
                                                          BlurRadius="16"
                                                          ShadowDepth="0"
                                                          Opacity="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.25" ScaleY="1.25" CenterX="24" CenterY="24"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ====== 整体容器：上方图标行 + 下方倒影 ====== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- 1. 图标行 -->
        <ItemsControl x:Name="IconBar"
                      Grid.Row="0"
                      ItemsSource="{Binding Apps}"
                      VerticalAlignment="Bottom">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center" Margin="6,4">
                        <Button Style="{StaticResource DockIconButtonStyle}"
                                ToolTip="{Binding Tooltip}"
                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Height>
                                <Binding Path="DataContext.DockIconSize"
                                         RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </Button.Height>
                            <Button.Width>
                                <Binding Path="DataContext.DockIconSize"
                                         RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </Button.Width>
                            <Image Source="{Binding Icon}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <TextBlock Text="{Binding Name}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center">
                            <TextBlock.MaxWidth>
                                <Binding Path="DataContext.DockIconSize"
                                         RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </TextBlock.MaxWidth>
                            <TextBlock.FontSize>
                                <Binding Path="DataContext.AppLabelFontSize"
                                         RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </TextBlock.FontSize>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Effect" Value="{StaticResource PanelAccentGlowSoft}"/>
                                    <Style.Triggers>
                                        <!-- 图标模式行展开后：显示应用名 -->
                                        <DataTrigger Binding="{Binding DataContext.ShowAppLabels,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <!-- 颜色跟随全局色调时切换 Foreground（默认白色在上面 Setter） -->
                                        <DataTrigger Binding="{Binding DataContext.AppLabelColorFollowTone,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource PanelAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 1.5 空状态占位：没有任何应用时显示，保证 Dock 仍然可见、可拖入 -->
        <Border Grid.Row="0"
                Width="56" Height="56"
                Margin="6"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="#66FFFFFF"
                Background="#22FFFFFF"
                ToolTip="把应用或快捷方式拖到这里">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- 默认隐藏，仅当图标行为空时显示 -->
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=IconBar}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="＋"
                       FontSize="28"
                       Foreground="#99FFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- 2. 倒影 -->
        <Rectangle Grid.Row="1"
                   Margin="6,0,6,0"
                   IsHitTestVisible="False">
            <Rectangle.Fill>
                <VisualBrush Visual="{Binding ElementName=IconBar}"/>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleY="-1" CenterY="18"/>
            </Rectangle.RenderTransform>
            <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#44000000"/>
                    <GradientStop Offset="1" Color="Transparent"/>
                </LinearGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>
    </Grid>
</Window>
