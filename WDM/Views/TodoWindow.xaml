<Window x:Class="WDM.Views.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办事项"
        Width="300"
        MinWidth="240"
        MinHeight="200"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 待办内部光标保持固定青色；滚动条滑块与面板边框 / 发光走 PanelAccent*，由全局色调控制。 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2CC7F7"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6BDDFF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#552CC7F7"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PanelAccentScrollBarStyle}"/>
    </Window.Resources>

    <Grid>
        <Border x:Name="PanelBorder"
                Style="{StaticResource GlassPanelStyle}" Padding="16,12,16,14">
            <DockPanel>

                <!-- ===== 标题栏（左键拖动，右键置顶 / 置底） ===== -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="置顶" Click="TopmostMenuItem_Click"/>
                            <MenuItem Header="置底" Click="BottomMenuItem_Click"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PanelTitleTextBoxStyle}"
                             ContextMenu="{Binding ContextMenu, RelativeSource={RelativeSource AncestorType=Grid}}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             MaxWidth="220"/>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Style="{StaticResource GlassGhostIconButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="删除"/>
                </Grid>

                <!-- ===== 底部输入行 ===== -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{DynamicResource GlassDividerBrush}"
                        BorderThickness="0,1,0,0"
                        Margin="0,8,0,0"
                        Padding="0,8,0,0">
                    <Grid>
                        <TextBox x:Name="InputBox"
                                 Style="{StaticResource GlassInputTextBoxStyle}"
                                 KeyDown="InputBox_KeyDown"/>
                        <TextBlock Text="添加待办，回车确认"
                                   IsHitTestVisible="False"
                                   Margin="2,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GlassCaptionTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ===== 待办列表 ===== -->
                <Grid>
                    <ScrollViewer x:Name="ListScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource AccentScrollViewerStyle}">
                        <ItemsControl x:Name="ItemList" ItemsSource="{Binding Items}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            Padding="6,4"
                                            Margin="2,1"
                                            Cursor="Hand"
                                            ToolTip="左键完成 / 右键编辑"
                                            MouseLeftButtonUp="TodoItem_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="修改" Click="EditItem_Click"/>
                                                <MenuItem Header="删除" Click="DeleteItem_Click"/>
                                                <MenuItem Header="置顶" Click="MoveToTop_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 完成状态圆点（点击切换完成） -->
                                            <Ellipse Width="14" Height="14"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"
                                                     MouseLeftButtonUp="Dot_MouseLeftButtonUp">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Stroke" Value="{DynamicResource PanelAccentBrush}"/>
                                                        <Setter Property="StrokeThickness" Value="1.5"/>
                                                        <Setter Property="Fill" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource PanelAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- 待办文本 -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource GlassTextMutedBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 星标按钮 -->
                                            <TextBlock Grid.Column="2"
                                                       Text="★"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Cursor="Hand"
                                                       Margin="4,0,0,0"
                                                       MouseLeftButtonUp="Star_MouseLeftButtonUp">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PanelAccentBrush}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PanelAccentBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态提示 -->
                    <TextBlock Text="暂无待办，回车添加"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GlassCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

            </DockPanel>
        </Border>

        <!-- 右下角拖拽缩放 -->
        <Thumb Style="{StaticResource PanelResizeGripStyle}"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,5,5"
               DragDelta="ResizeThumb_DragDelta"/>
    </Grid>
</Window>
