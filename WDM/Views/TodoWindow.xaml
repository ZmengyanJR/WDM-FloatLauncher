<Window x:Class="WDM.Views.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办事项"
        Width="300"
        MinWidth="240"
        MinHeight="200"
        MaxHeight="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Border Style="{StaticResource GlassPanelStyle}" Padding="16,12,16,14">
            <DockPanel>

                <!-- ===== 标题栏（可拖动） ===== -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="待办事项"
                               Style="{StaticResource GlassTitleTextStyle}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Cursor="Hand">
                        <Button Content="✕"
                                Style="{StaticResource GlassGhostIconButtonStyle}"
                                Margin="6,0,0,0"
                                Click="CloseButton_Click"
                                ToolTip="删除"/>
                    </StackPanel>
                </Grid>

                <!-- ===== 底部输入行 ===== -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{DynamicResource GlassDividerBrush}"
                        BorderThickness="0,1,0,0"
                        Margin="0,8,0,0"
                        Padding="0,8,0,0">
                    <Grid>
                        <TextBox x:Name="InputBox"
                                 Style="{StaticResource GlassInputTextBoxStyle}"
                                 KeyDown="InputBox_KeyDown"/>
                        <TextBlock Text="添加待办，回车确认"
                                   IsHitTestVisible="False"
                                   Margin="2,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GlassCaptionTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ===== 待办列表 ===== -->
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            Padding="8,6"
                                            ToolTip="左键完成 / 右键删除"
                                            MouseLeftButtonUp="TodoItem_MouseLeftButtonUp"
                                            MouseRightButtonUp="TodoItem_MouseRightButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 完成状态圆点 -->
                                            <Ellipse Width="14" Height="14"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Stroke"
                                                                Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <Setter Property="StrokeThickness" Value="1.5"/>
                                                        <Setter Property="Fill" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Fill"
                                                                        Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- 待办文本 -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource GlassTextMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态提示 -->
                    <TextBlock Text="暂无待办，回车添加"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GlassCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

            </DockPanel>
        </Border>

        <!-- 右下角拖拽缩放 -->
        <Thumb Style="{StaticResource PanelResizeGripStyle}"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,5,5"
               DragDelta="ResizeThumb_DragDelta"/>
    </Grid>
</Window>
