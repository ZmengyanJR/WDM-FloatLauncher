<Window x:Class="WDM.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置中心"
        Width="410"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border CornerRadius="18"
            Background="{StaticResource PanelDarkBrush}"
            BorderBrush="{StaticResource PanelStrokeBrush}"
            BorderThickness="1"
            Effect="{StaticResource PanelShadow}">
        <Grid Margin="22,14,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏（可拖动） ===== -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Ellipse Width="8" Height="8"
                             Fill="{StaticResource AccentBrush}"
                             Effect="{StaticResource AccentGlow}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock Text="设置中心"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        Style="{StaticResource GhostIconButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTip="关闭"/>
            </Grid>

            <!-- ===== 透明度表盘 ===== -->
            <Canvas x:Name="GaugeCanvas"
                    Grid.Row="1"
                    Width="300" Height="168"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonDown="Gauge_MouseLeftButtonDown"
                    MouseMove="Gauge_MouseMove"
                    MouseLeftButtonUp="Gauge_MouseLeftButtonUp"
                    MouseLeave="Gauge_MouseLeave">
                <TextBlock Text="{Binding GaugeMinLabel}"
                           Canvas.Left="12" Canvas.Top="136"
                           Style="{StaticResource DarkCaptionTextStyle}"/>
                <TextBlock Text="{Binding GaugeMaxLabel}"
                           Canvas.Right="12" Canvas.Top="136"
                           Style="{StaticResource DarkCaptionTextStyle}"/>
            </Canvas>

            <!-- ===== 表盘读数 ===== -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,-4,0,2">
                <TextBlock Text="{Binding GaugeText}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding GaugeCaption}"
                           Style="{StaticResource DarkCaptionTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Row="3" Height="1" Background="{StaticResource DividerBrush}" Margin="0,12"/>

            <!-- ===== 桌面组件 ===== -->
            <TextBlock Grid.Row="4"
                       Text="桌面组件"
                       Style="{StaticResource DarkCaptionTextStyle}"
                       Margin="10,0,0,4"/>

            <!-- 便签：点击本行切换表盘为便签透明度，再次点击返回 Dock -->
            <Border Grid.Row="5" Style="{StaticResource SettingsRowStyle}" Cursor="Hand"
                    Tag="Note" MouseLeftButtonDown="PanelRow_MouseLeftButtonDown"
                    ToolTip="点击调节便签透明度">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 统一图标：圆角底 + Segoe MDL2 字形 -->
                    <Border Style="{StaticResource SettingsIconBoxStyle}"
                            Background="#26FFC46B" BorderBrush="#4DFFC46B">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource SettingsIconGlyphStyle}"
                                   Foreground="#FFC46B"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="便签" Style="{StaticResource DarkTitleTextStyle}"/>
                        <TextBlock Text="新增便签；点击本行可调节透明度"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource AccentCircleButtonStyle}"
                            Command="{Binding AddNoteCommand}"
                            VerticalAlignment="Center"
                            ToolTip="新增一张便签"/>
                </Grid>
            </Border>

            <!-- 待办事项：点击本行切换表盘为待办透明度，再次点击返回 Dock -->
            <Border Grid.Row="6" Style="{StaticResource SettingsRowStyle}" Cursor="Hand"
                    Tag="Todo" MouseLeftButtonDown="PanelRow_MouseLeftButtonDown"
                    ToolTip="点击调节待办透明度">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBoxStyle}"
                            Background="#265FD99B" BorderBrush="#4D5FD99B">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource SettingsIconGlyphStyle}"
                                   Foreground="#5FD99B"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="待办事项" Style="{StaticResource DarkTitleTextStyle}"/>
                        <TextBlock Text="新增待办；点击本行可调节透明度"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource AccentCircleButtonStyle}"
                            Command="{Binding AddTodoCommand}"
                            VerticalAlignment="Center"
                            ToolTip="新增一个待办面板"/>
                </Grid>
            </Border>

            <!-- 夜间模式 -->
            <Border Grid.Row="7" Style="{StaticResource SettingsRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBoxStyle}"
                            Background="#268FA8FF" BorderBrush="#4D8FA8FF">
                        <TextBlock Text="&#xE708;" Style="{StaticResource SettingsIconGlyphStyle}"
                                   Foreground="#8FA8FF"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="夜间模式" Style="{StaticResource DarkTitleTextStyle}"/>
                        <TextBlock Text="便签与待办切换为黑色毛玻璃"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding NightMode}"
                              VerticalAlignment="Center"
                              ToolTip="夜间模式"/>
                </Grid>
            </Border>

            <!-- 开机自启动 -->
            <Border Grid.Row="8" Style="{StaticResource SettingsRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBoxStyle}"
                            Background="#262CC7F7" BorderBrush="#4D2CC7F7">
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource SettingsIconGlyphStyle}"
                                   Foreground="#2CC7F7"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="开机自启动" Style="{StaticResource DarkTitleTextStyle}"/>
                        <TextBlock Text="登录 Windows 后自动在后台运行 WDM"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding AutoStart}"
                              VerticalAlignment="Center"
                              ToolTip="开机自启动"/>
                </Grid>
            </Border>

            <!-- 图标模式：点击本行切换表盘为图标色调，再次点击返回 Dock -->
            <Border Grid.Row="9" Style="{StaticResource SettingsRowStyle}" Cursor="Hand"
                    Tag="Icon" MouseLeftButtonDown="PanelRow_MouseLeftButtonDown"
                    ToolTip="点击调节图标色调">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsIconBoxStyle}"
                            Background="#26FF9E7A" BorderBrush="#4DFF9E7A">
                        <TextBlock Text="&#xE790;" Style="{StaticResource SettingsIconGlyphStyle}"
                                   Foreground="#FF9E7A"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="图标模式" Style="{StaticResource DarkTitleTextStyle}"/>
                        <TextBlock Text="开启科技霓虹；点击本行可调节色调"
                                   Style="{StaticResource DarkCaptionTextStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding TechIconMode}"
                              VerticalAlignment="Center"
                              ToolTip="默认模式 / 科技模式"/>
                </Grid>
            </Border>

            <!-- ===== 图标色调滑轨（仅科技模式可见） ===== -->
            <StackPanel Grid.Row="10"
                        Margin="10,4,10,0"
                        Visibility="{Binding TechIconMode, Converter={StaticResource BooleanToVisibility}}">
                <Grid Margin="0,0,2,0">
                    <TextBlock Text="图标色调" Style="{StaticResource DarkCaptionTextStyle}"/>
                    <TextBlock Text="{Binding IconTone, StringFormat={}{0:F0}°}"
                               HorizontalAlignment="Right"
                               Style="{StaticResource DarkCaptionTextStyle}"/>
                </Grid>
                <Slider Style="{StaticResource HueSliderStyle}"
                        Minimum="0" Maximum="360"
                        Value="{Binding IconTone, Mode=TwoWay}"
                        Margin="0,6,0,2"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
